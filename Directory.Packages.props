<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core paketi -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- Google Sign-In: server-side ID token verification (GoogleJsonWebSignature).
         Official library — we don't hand-roll JWKS/RS256 (same rationale as using
         the framework PasswordHasher). Version tracks google-api-dotnet-client
         releases; if restore rejects it, bump to the latest 1.x. -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.75.0" />
    <!-- Storage (Cloudflare R2, S3-compatible) -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102" />
    <!-- Plaćanje: Stripe Checkout + webhook. API koji koristimo (SessionService,
         EventUtility.ConstructEvent) stabilan je kroz v46–v51. Ako restore odbije
         ovu verziju, bumpaj na najnoviju 51.x. -->
    <PackageVersion Include="Stripe.net" Version="51.0.0" />
    <!-- Imaging: libvips thumbnails. NetVips.Native bundles the native libvips
         (with HEIF/HEIC) for all platforms — simplest cross-platform story for
         local dev + Railway (Linux). Slim later to NetVips.Native.linux-x64 if
         deploy size matters. If restore rejects a version, bump to latest. -->
    <PackageVersion Include="NetVips" Version="2.4.1" />
    <PackageVersion Include="NetVips.Native" Version="8.15.3" />
    <!-- Sigurnosni override: ranjivi transitivni paketi -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="1.6.22" />
  </ItemGroup>
</Project>
