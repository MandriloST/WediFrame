# Public base URL of the WediFrame API (used by the browser AND server
# components). No trailing slash. Copy this file to web/.env.local and adjust.
#
# Local dev (API on :5080):
NEXT_PUBLIC_API_URL=http://localhost:5080/api/v1
#
# The API must allow this web origin via Frontend:AllowedOrigins (CORS) —
# see the API appsettings. For local dev that is http://localhost:3000.
#
# Google Sign-In (optional). Set this to the SAME OAuth Web Client ID configured
# on the API (Auth:Google:ClientId). Leave empty to hide the Google button.
# There is NO client secret in the frontend — approach B verifies the ID token
# server-side. Get the Client ID from Google Cloud Console → Credentials →
# OAuth client ID → Web application (JavaScript origin http://localhost:3000).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
